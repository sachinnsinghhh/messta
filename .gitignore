# Dependencies (Never commit node_modules)
node_modules/
*/node_modules/
backend/node_modules/
frontend/node_modules/

# Secrets & Environment Variables (Never commit real API keys or DB passwords)
.env
.env.*
*.env
backend/.env
frontend/.env
*.local
.env.local
.env.production.local

# Production Build Outputs
dist/
dist-ssr/
frontend/dist/
backend/dist/
build/

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Editor & IDE Directories
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Log files
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Python & Temporary Output Artifacts
__pycache__/
*.pyc
*.pyo
manual_source.html
